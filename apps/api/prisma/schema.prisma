// Tropa dos Dados — Prisma schema
// Fonte: specs/02-arquitetura.md §2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identidade e acesso ----------

enum UserStatus {
  active
  suspended
  deleted
}

enum Role {
  student
  mentor
  admin
  company_admin
  sponsor
  judge
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  profile        Profile?
  roles          UserRole[]
  sessions       Session[]
  memberships    CompanyMembership[]
  xpEvents       XpEvent[]
  userXp         UserXp?
  streak         Streak?
  leagueRankings LeagueRanking[]
  notifications  Notification[]
  devices        Device[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  sandboxSessions SandboxSession[]
  projectSubmissions ProjectSubmission[]
  skillScores    SkillScore[]
  cvs            Cv[]
  pdiPlans       PdiPlan[]
  jobApplications JobApplication[]
  hackathonTeamMembers HackathonTeamMember[]
  hackathonSubmissions HackathonSubmission[]
  certificates   Certificate[]
  badges         UserBadge[]
  readingProgress ReadingProgress[]

  @@index([status])
}

model Profile {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @unique @map("user_id") @db.Uuid
  headline            String?
  bio                 String?
  timezone            String  @default("America/Sao_Paulo")
  learningStyle       String? @map("learning_style") // visual/auditivo/leitura/pratico
  careerGoal          String? @map("career_goal")
  linkedinUrl         String? @map("linkedin_url")
  githubUrl           String? @map("github_url")
  consentMarketingAt  DateTime? @map("consent_marketing_at")
  consentTermsVersion String? @map("consent_terms_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserRole {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  role           Role
  scopes         Json?   // ex.: {"hackathon_id": "..."}
  organizationId String? @map("organization_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, organizationId])
  @@map("user_roles")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  deviceMeta       Json?    @map("device_meta")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Organizações (B2B/instituição/patrocinador) ----------

enum OrgType {
  company
  institution
  sponsor
}

model Organization {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  cnpj         String? @unique
  type         OrgType
  planId       String? @map("plan_id")
  billingEmail String? @map("billing_email")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships CompanyMembership[]
  jobs        Job[]
  hackathons  Hackathon[]

  @@index([type])
}

model CompanyMembership {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  role            String    @default("member") // admin/manager/member
  seatActive      Boolean   @default(true) @map("seat_active")
  seatExpiresAt   DateTime? @map("seat_expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("company_memberships")
}

// ---------- Conteúdo ----------

enum ContentStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  article
  sandbox
  quiz
  project
  challenge
}

model Course {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  description String?
  coverUrl    String?       @map("cover_url")
  level       String?
  status      ContentStatus @default(draft)
  xpTotal     Int           @default(0) @map("xp_total")
  authorId    String?       @map("author_id") @db.Uuid
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  modules Module[]

  @@index([status])
  @@index([publishedAt])
}

model Module {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  title            String
  position         Int
  type             String   @default("watch") // watch/do/play
  codename         String?
  estimatedMinutes Int      @default(0) @map("estimated_minutes")
  xpAward          Int      @default(0) @map("xp_award")
  unlockXp         Int      @default(0) @map("unlock_xp")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
lessons     Lesson[]
  projects    Project[]

  @@index([courseId, position])
}

model Lesson {
  id          String     @id @default(uuid()) @db.Uuid
  moduleId    String     @map("module_id") @db.Uuid
  title       String
  position    Int
  type        LessonType
  content     Json?
  durationSec Int        @default(0) @map("duration_seconds")
  xpAward     Int        @default(0) @map("xp_award")
  locked      Boolean    @default(false)

  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress   LessonProgress[]
  quiz       Quiz?
  sandbox    Sandbox?
  project    Project?
  requires   LessonRequirement[] @relation("requires")
  requiredBy LessonRequirement[] @relation("requiredBy")

  @@index([moduleId, position])
}

model LessonRequirement {
  lessonId         String @map("lesson_id") @db.Uuid
  requiresLessonId String @map("requires_lesson_id") @db.Uuid

  lesson         Lesson @relation("requires", fields: [lessonId], references: [id], onDelete: Cascade)
  requiresLesson Lesson @relation("requiredBy", fields: [requiresLessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, requiresLessonId])
  @@map("lesson_requires")
}

model LessonProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  lessonId            String    @map("lesson_id") @db.Uuid
  status              String    @default("started") // started/completed
  watchedSeconds      Int       @default(0) @map("watched_seconds")
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  completedAt         DateTime? @map("completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ---------- Quizzes ----------

model Quiz {
  id             String @id @default(uuid()) @db.Uuid
  lessonId       String @unique @map("lesson_id") @db.Uuid
  mode           String @default("adaptive") // adaptive/fixed
  passingScore   Int    @default(60) @map("passing_score")
  timeLimitSec   Int?   @map("time_limit_seconds")
  shuffle        Boolean @default(true)
  xpAward        Int    @default(0) @map("xp_award")
  maxAttempts    Int    @default(3) @map("max_attempts")

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  prompt       String
  options      Json
  correctIndex Int      @map("correct_index")
  difficulty   Int      @default(3) // 1..5
  skillId      String?  @map("skill_id") @db.Uuid
  explanation  String?
  category     String?

  quiz      Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   UserQuestionAnswer[]
  skill     SkillTaxonomy?       @relation(fields: [skillId], references: [id])

  @@map("quiz_questions")
}

model QuizAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  quizId         String    @map("quiz_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  score          Int       @default(0)
  earnedXp       Int       @default(0) @map("earned_xp")
  adaptiveState  Json?     @map("adaptive_state") // vetor theta (IRT)

  quiz       Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    UserQuestionAnswer[]

  @@index([quizId, userId])
  @@map("quiz_attempts")
}

model UserQuestionAnswer {
  id          String  @id @default(uuid()) @db.Uuid
  attemptId   String  @map("attempt_id") @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  chosenIndex Int     @map("chosen_index")
  correct     Boolean
  timeMs      Int     @map("time_ms")

  attempt  QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("user_question_answers")
}

// ---------- Sandbox ----------

enum SandboxEngine {
  sql
  python
  r
  excel
}

model Sandbox {
  id               String        @id @default(uuid()) @db.Uuid
  lessonId         String?       @unique @map("lesson_id") @db.Uuid
  title            String
  engine           SandboxEngine
  spec             Json          // datasets, setup, prompt, hidden_tests
  difficulty       Int           @default(3)
  xpAward          Int           @default(0) @map("xp_award")
  maxServerSeconds Int           @default(60) @map("max_server_seconds")

  lesson   Lesson?           @relation(fields: [lessonId], references: [id])
  datasets SandboxDataset[]
  sessions SandboxSession[]

  @@index([engine])
}

model Dataset {
  id         String @id @default(uuid()) @db.Uuid
  name       String @unique
  storageKey String @map("storage_key")
  format     String @default("csv")
  rows       Int    @default(0)
  schema     Json?
  sizeBytes  Int    @default(0) @map("size_bytes")
  license    String?

  sandboxDatasets SandboxDataset[]
}

model SandboxDataset {
  sandboxId  String @map("sandbox_id") @db.Uuid
  datasetId  String @map("dataset_id") @db.Uuid

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([sandboxId, datasetId])
  @@map("sandbox_datasets")
}

model SandboxSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  sandboxId       String    @map("sandbox_id") @db.Uuid
  engineSessionId String?   @map("engine_session_id")
  status          String    @default("open")
  cells           Json?
  lastActiveAt    DateTime? @map("last_active_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  events SandboxEvent[]

  @@index([userId, sandboxId])
  @@map("sandbox_sessions")
}

model SandboxEvent {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  type       String   // run/copy/paste/navigate
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  session SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("sandbox_events")
}

// ---------- Projetos ----------

model Project {
  id                String   @id @default(uuid()) @db.Uuid
  lessonId          String?  @unique @map("lesson_id") @db.Uuid
  moduleId          String   @map("module_id") @db.Uuid
  title             String
  briefMd           String   @map("brief_md")
  acceptanceCriteria Json?   @map("acceptance_criteria")
  evaluationMode    String   @default("auto") @map("evaluation_mode") // auto/mentor/hybrid
  gradingTests      Json?
  rubric            Json?
  xpAward           Int      @default(0) @map("xp_award")

  lesson      Lesson?            @relation(fields: [lessonId], references: [id])
  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]

  @@index([moduleId])
}

model ProjectSubmission {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  status      String    @default("submitted")
  artifacts   Json?
  score       Int?
  earnedXp    Int       @default(0) @map("earned_xp")
  submittedAt DateTime  @default(now()) @map("submitted_at")

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  grades  ProjectGrade[]

  @@index([projectId, userId])
  @@map("project_submissions")
}

model ProjectGrade {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  grader       String   @default("auto") // auto/mentor/ai
  graderUserId String?  @map("grader_user_id") @db.Uuid
  score        Int?
  rubricScores Json?    @map("rubric_scores")
  feedbackMd   String?  @map("feedback_md")
  gradedAt     DateTime @default(now()) @map("graded_at")

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("project_grades")
}

// ---------- Skills / PDI / CV ----------

model SkillTaxonomy {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  parentId    String? @map("parent_id") @db.Uuid
  category    String  // sql/python/r/excel/estatistica/ml/soft
  levelMax    Int     @default(5) @map("level_max") // S0..S5
  description String?

  parent   SkillTaxonomy?  @relation("SkillTree", fields: [parentId], references: [id])
  children SkillTaxonomy[] @relation("SkillTree")
  scores   SkillScore[]
  questions QuizQuestion[]

  @@index([category])
  @@map("skill_taxonomy")
}

model SkillScore {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  skillId        String   @map("skill_id") @db.Uuid
  level          Int      @default(0) // 0..5
  confidence     Float    @default(0)
  lastAssessedAt DateTime? @map("last_assessed_at")
  source         String   @default("quiz") // quiz/pdi/sandbox/hackathon

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill SkillTaxonomy @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("skill_scores")
}

model Cv {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  filename    String
  storageKey  String    @map("storage_key")
  mime        String
  parseStatus String    @default("pending") @map("parse_status")
  parsed      Json?
  isCurrent   Boolean   @default(false) @map("is_current")
  createdAt   DateTime  @default(now()) @map("created_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  review CvReview?

  @@index([userId, isCurrent])
}

model CvReview {
  id           String   @id @default(uuid()) @db.Uuid
  cvId         String   @unique @map("cv_id") @db.Uuid
  status       String   @default("processing")
  overallScore Int      @default(0) @map("overall_score")
  summaryMd    String?  @map("summary_md")
  sections     Json?
  atsScore     Int      @default(0) @map("ats_score")
  strengths    Json?
  improvements Json?
  model        String?
  costCents    Int      @default(0) @map("cost_cents")
  generatedAt  DateTime @default(now()) @map("generated_at")

  cv Cv @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@map("cv_reviews")
}

model PdiPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  version   Int      @default(1)
  status    String   @default("active") // draft/active/completed
  objective String?
  source    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes PdiNode[]

  @@index([userId, status])
  @@map("pdi_plans")
}

model PdiNode {
  id                 String    @id @default(uuid()) @db.Uuid
  pdiPlanId          String    @map("pdi_plan_id") @db.Uuid
  parentId           String?   @map("parent_id") @db.Uuid
  type               String    // milestone/skill/course/project/hackathon
  title              String
  skillId            String?   @map("skill_id") @db.Uuid
  recommendedContent Json?    @map("recommended_content")
  estimatedWeeks     Int?      @map("estimated_weeks")
  orderIndex         Int       @default(0) @map("order_index")
  status             String    @default("todo") // todo/in_progress/done
  progress           Int       @default(0)

  plan   PdiPlan?    @relation(fields: [pdiPlanId], references: [id], onDelete: Cascade)
  parent PdiNode?    @relation("PdiTree", fields: [parentId], references: [id])
  child  PdiNode[]   @relation("PdiTree")

  @@index([pdiPlanId, orderIndex])
  @@map("pdi_nodes")
}

// ---------- Gamificação ----------

model XpEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   // lesson_complete/quiz_pass/sandbox_complete/project_graded/streak_day/hackathon/badge/daily_login/referral/reading
  sourceId   String?  @map("source_id")
  amount     Int
  uniqueKey  String   @unique @map("unique_key")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("xp_events")
}

model UserXp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  totalXp   Int      @default(0) @map("total_xp")
  weekXp    Int      @default(0) @map("week_xp")
  weekStart DateTime @default(now()) @map("week_start")
  level     Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_xp")
}

model Streak {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  current          Int       @default(0)
  longest          Int       @default(0)
  lastActivityDate DateTime? @map("last_activity_date")
  freezesAvailable Int       @default(0) @map("freezes_available")
  freezesUsed      Int       @default(0) @map("freezes_used")
  timezone         String    @default("America/Sao_Paulo")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  name        String
  description String?
  icon        String?
  criteria    Json?

  userBadges UserBadge[]
}

model UserBadge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  badgeId   String    @map("badge_id") @db.Uuid
  progress  Json?
  earnedAt  DateTime? @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model League {
  id              String    @id @default(uuid()) @db.Uuid
  season          Int
  weekStart       DateTime  @map("week_start")
  weekEnd         DateTime  @map("week_end")
  status          String    @default("open") // open/settling/settled
  cohortSize      Int       @default(0) @map("cohort_size")
  promotionCount  Int       @default(0) @map("promotion_count")

  rankings LeagueRanking[]

  @@unique([season, weekStart])
  @@index([status])
}

model LeagueRanking {
  id                  String   @id @default(uuid()) @db.Uuid
  leagueId            String   @map("league_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  xp                  Int      @default(0)
  rank                Int
  eligiblePromotion   Boolean  @default(false) @map("eligible_promotion")

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([leagueId, rank])
  @@map("league_rankings")
}

// ---------- Notificações ----------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  channel   String    @default("in_app")
  title     String
  body      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  sentAt    DateTime  @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model Device {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  platform   String
  pushToken  String @map("push_token")
  topics     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Mural de vagas ----------

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String
  description    String?
  requirements   Json?
  location       String?
  workMode       String?   @map("work_mode")
  salaryMin      Int?      @map("salary_min")
  salaryMax      Int?      @map("salary_max")
  seniority      String?
  skills         Json?     // [{skill_id, level}]
  status         String    @default("open")
  postedAt       DateTime  @default(now()) @map("posted_at")
  closesAt       DateTime? @map("closes_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  applications JobApplication[]

  @@index([status, postedAt])
}

model JobApplication {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @map("job_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  status          String    @default("applied")
  fitScore        Int?      @map("fit_score")
  cvSnapshot      Json?     @map("cv_snapshot")
  answers         Json?
  appliedAt       DateTime  @default(now()) @map("applied_at")
  employerViewedAt DateTime? @map("employer_viewed_at")

  job Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@map("job_applications")
}

// ---------- Hackathon ----------

enum HackathonStatus {
  draft
  open
  running
  judging
  closed
}

model Hackathon {
  id                  String          @id @default(uuid()) @db.Uuid
  sponsorOrgId        String?         @map("sponsor_org_id") @db.Uuid
  title               String
  theme               String?
  rulesMd             String?         @map("rules_md")
  startAt             DateTime?       @map("start_at")
  endAt               DateTime?       @map("end_at")
  submissionDeadline  DateTime?       @map("submission_deadline")
  status              HackathonStatus @default(draft)
  prizePoolCents      Int             @default(0) @map("prize_pool_cents")
  judgingCriteria     Json?           @map("judging_criteria")
  maxTeamSize         Int             @default(4) @map("max_team_size")
  xpMultiplier        Float           @default(1) @map("xp_multiplier")
  createdAt           DateTime        @default(now()) @map("created_at")

  sponsor     Organization?      @relation(fields: [sponsorOrgId], references: [id])
  teams       HackathonTeam[]
  submissions HackathonSubmission[]
  prizes      HackathonPrize[]

  @@index([status])
}

model HackathonPrize {
  id          String  @id @default(uuid()) @db.Uuid
  hackathonId String  @map("hackathon_id") @db.Uuid
  position    Int
  amountCents Int     @map("amount_cents")
  description String?

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([hackathonId, position])
  @@map("hackathon_prizes")
}

model HackathonTeam {
  id          String    @id @default(uuid()) @db.Uuid
  hackathonId String    @map("hackathon_id") @db.Uuid
  name        String
  leaderUserId String   @map("leader_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  hackathon Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  members   HackathonTeamMember[]
  submissions HackathonSubmission[]

  @@index([hackathonId])
  @@map("hackathon_teams")
}

model HackathonTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")

  team HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("hackathon_team_members")
}

model HackathonSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  hackathonId String   @map("hackathon_id") @db.Uuid
  teamId      String?  @map("team_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  repoUrl     String?  @map("repo_url")
  demoUrl     String?  @map("demo_url")
  storageKeys Json?    @map("storage_keys")
  submittedAt DateTime @default(now()) @map("submitted_at")
  status      String   @default("submitted") // submitted/shortlisted/winner

  hackathon Hackathon        @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team      HackathonTeam?   @relation(fields: [teamId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores    HackathonScore[]

  @@index([hackathonId])
  @@map("hackathon_submissions")
}

model HackathonScore {
  id            String  @id @default(uuid()) @db.Uuid
  submissionId  String  @map("submission_id") @db.Uuid
  judgeId       String  @map("judge_id") @db.Uuid
  criteriaScores Json?  @map("criteria_scores")
  totalScore    Int     @default(0) @map("total_score")
  feedbackMd    String? @map("feedback_md")
  scoredAt      DateTime @default(now()) @map("scored_at")

  submission HackathonSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
  @@map("hackathon_scores")
}

// ---------- Certificados ----------

model Certificate {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @default("course") // course/hackathon/reading
  referenceId String?   @map("reference_id") // course_id | hackathon_id | ebook_id
  title       String
  hours       Int       @default(0)
  serial      String    @unique
  issuedAt    DateTime  @default(now()) @map("issued_at")
  verifyUrl   String?   @map("verify_url")
  pdfKey      String?   @map("pdf_key")
  status      String    @default("issued")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
}

// ---------- Biblioteca ----------

model Ebook {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  title        String
  author       String?
  category     String
  pages        Int      @default(0)
  description  String?
  storageKey   String?  @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  progress ReadingProgress[]

  @@index([category])
}

model ReadingProgress {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ebookId    String   @map("ebook_id") @db.Uuid
  readPages  Int      @default(0) @map("read_pages")
  status     String   @default("lendo") // lendo/concluido
  completedAt DateTime? @map("completed_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
  @@map("reading_progress")
}

// ---------- Auditoria ----------

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}