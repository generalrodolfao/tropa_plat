# Banco local (docker-compose)
DATABASE_URL="postgresql://tropa:tropa@localhost:5432/tropa?schema=public"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-troca-em-prod"
JWT_REFRESH_SECRET="dev-refresh-secret-troca-em-prod"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Servidor
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:3000"

# Redis (BullMQ / cache / rate limit)
REDIS_URL="redis://localhost:6379"

# IA — OpenRouter (provider principal, OpenAI-compatible)
OPENROUTER_API_KEY=""
# Opcionais
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_NAME="Tropa dos Dados"
# OPENROUTER_SITE_URL="https://tropadosdados.com"
# OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"

# Fallbacks opcionais (usados se configurados)
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# E-mail transacional (Resend) — sem a chave, apenas loga
# RESEND_API_KEY=""
EMAIL_FROM="Tropa dos Dados <no-reply@tropadosdados.com>"
WEB_APP_URL="http://localhost:3000"

# Seed no boot (apenas na primeira subida em produção; o seed é destrutivo)
# SEED_ON_BOOT="true"