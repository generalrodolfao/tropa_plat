# Configuração do monitor da VPS (Tropa dos Dados)
# Instale em /etc/tropa/monitor.env

# Caminho monitorado
DISK_PATH=/

# Limiares de uso de disco (%)
DISK_WARN=80
DISK_CRIT=90

# Limiares de expiração do certificado (dias)
CERT_WARN_DAYS=20
CERT_CRIT_DAYS=7

# Webhook opcional (Slack/Discord/generic) para alertas
# ALERT_WEBHOOK_URL=
