# ============================================
# TROPA DOS DADOS - Environment Variables
# ============================================

# ----- Database (PostgreSQL) -----
DATABASE_URL="postgresql://tropa:tropa@localhost:5432/tropa"

# ----- Redis -----
REDIS_URL="redis://localhost:6379"

# ----- JWT -----
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ----- CORS -----
CORS_ORIGIN="http://localhost:3000,https://your-domain.com"

# ----- Mercado Pago -----
MP_ACCESS_TOKEN="your-mp-access-token"
MP_PUBLIC_KEY="your-mp-public-key"
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# ----- Cloudflare Stream -----
CF_ACCOUNT_ID="your-cf-account-id"
CF_STREAM_TOKEN_ID="your-cf-stream-token-id"
CF_STREAM_TOKEN_VALUE="your-cf-stream-token-value"

# ----- AI (OpenAI / Gemini) -----
OPENAI_API_KEY="your-openai-key"
GEMINI_API_KEY="your-gemini-key"

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ----- App -----
APP_NAME="Tropa dos Dados"
APP_URL="http://localhost:3000"
